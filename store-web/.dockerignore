# Cypress: the `cypress/` directory MUST stay in the build context.
# Its `support/commands.ts` contains `/// <reference types="cypress" />`
# which registers cypress global types (describe, it, cy.mount) used
# by `src/__test__/*.cy.tsx`. We only exclude the heavy outputs.
cypress/videos/
cypress/screenshots/
cypress.config.ts

