				{
					"name": "Calculate Discount",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const expectedBurnPoint = parseInt(pm.variables.get(\"expected_burn_point\"));",
									"const expectedDiscount = parseFloat(pm.variables.get(\"expected_discount\"));",
									"",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const schema = {",
									"    \"burn_point\": {",
									"        \"type\": \"integer\"",
									"    },",
									"    \"discount\": {",
									"        \"type\": \"number\"",
									"    }",
									"};",
									"",
									"const jsonData = pm.response.json();",
									"",
									"pm.test('Response body schema is valid', function () {",
									"    pm.expect(tv4.validate(jsonData, schema)).to.be.true;",
									"});",
									"",
									"pm.test(`Burn point should be ${expectedBurnPoint}`, function () {",
									"    pm.expect(jsonData.burn_point).to.eql(expectedBurnPoint);",
									"});",
									"",
									"pm.test(`Discount should be ${expectedDiscount} THB`, function () {",
									"    pm.expect(jsonData.discount).to.eql(expectedDiscount);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{STORE_SERVICE_URL}}/api/v1/point/discount?points={{points}}&subtotal={{subtotal}}",
							"host": [
								"{{STORE_SERVICE_URL}}"
							],
							"path": [
								"api",
								"v1",
								"point",
								"discount"
							],
							"query": [
								{
									"key": "points",
