				{
					"name": "Order Summary shows the Discount",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const burnPoints = parseInt(pm.variables.get(\"burn_points\"));",
									"const expectedDiscount = parseFloat(pm.variables.get(\"expected_discount\"));",
									"const subtotalPrice = parseFloat(pm.variables.get(\"subtotal_price\"));",
									"const totalPrice = parseFloat(pm.variables.get(\"total_price\"));",
									"const receivingPoint = parseInt(pm.variables.get(\"receiving_point\"));",
									"",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"",
									"pm.test(`Sub total price should be ${subtotalPrice}`, function () {",
									"    pm.expect(jsonData.sub_total_price).to.eql(subtotalPrice);",
									"});",
									"",
									"pm.test(`Discount price should be ${expectedDiscount}`, function () {",
									"    pm.expect(jsonData.discount_price).to.eql(expectedDiscount);",
									"});",
									"",
									"pm.test(`Burn point should be ${burnPoints}`, function () {",
									"    pm.expect(jsonData.burn_point).to.eql(burnPoints);",
									"});",
									"",
									"pm.test(`Total price should be ${totalPrice}`, function () {",
									"    pm.expect(jsonData.total_price).to.eql(totalPrice);",
									"});",
									"",
									"pm.test(`Receiving point should be ${receivingPoint} (earned on the discounted amount)`, function () {",
									"    pm.expect(jsonData.receiving_point).to.eql(receivingPoint);",
									"});"
